# ローカルで動かすときに .env.local にコピーして使う（Git には入らない）
# Vercel では「Settings → Environment Variables」、GitHub では「Settings → Secrets and variables → Actions」に入れる

# --- Web（Vercel）とパイプライン（GitHub Actions）の両方 ---
# Neon などの Postgres の接続文字列（Vercel で Neon を連携すると自動で入る）
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# タイムゾーン（既定 Asia/Tokyo）
# PNBA_TZ=Asia/Tokyo

# --- Web（Vercel） ---
# ログインのパスワード（必須）。長くて推測されにくいものに
PNBA_PASSWORD=
# 「今すぐ集める」ボタン用（任意）。このリポジトリの Actions を起動できる GitHub のトークン
# PNBA_GITHUB_TOKEN=
# リポジトリ名（Vercel なら自動で分かるので通常は不要）
# PNBA_GITHUB_REPO=owner/repo

# --- パイプライン（GitHub Actions の Secrets） ---
# Gemini API キー（https://aistudio.google.com/apikey）
GEMINI_API_KEY=
# Discord に「今日の N 本」を送る（任意。設定画面でも入れられる）
# PNBA_DISCORD_WEBHOOK_URL=
# 通知に載せるこのアプリの URL（任意。Actions では Variables に入れる）
# PNBA_PUBLIC_URL=https://your-app.vercel.app
# 使うモデル（任意。Actions では Variables に入れる）
# PNBA_GEMINI_MODEL=gemini-flash-latest
