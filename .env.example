# コピーして .env にし、値を入れてください（.env は Git に入りません）

# AI（どちらか）: Gemini API キー。https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=
# PNBA_GEMINI_MODEL=gemini-flash-latest
# API キーを使わない場合は agy -p を使う（agy をインストールしてログインしておく）
# PNBA_AGY_CMD=agy
# PNBA_AGY_MODEL=

# ログインのパスワード。外（スマホなど）から見るなら必須。長くて推測されにくいものに
PNBA_PASSWORD=

# 待ち受け。外から見るなら 0.0.0.0（パスワード必須）
PNBA_HOST=127.0.0.1
PNBA_PORT=8000
# HTTPS で公開するときは 1（Cookie を HTTPS のみにする）
PNBA_SECURE_COOKIE=0
# リバースプロキシ（Caddy・Cloudflare Tunnel など）の後ろで動かすなら 1（ログイン試行の制限を実際の接続元で数える）
PNBA_TRUST_PROXY=0

PNBA_TZ=Asia/Tokyo
# PNBA_DATA_DIR=./data

# 通知（任意）。Discord の Webhook と、通知に載せるこのアプリの URL
PNBA_DISCORD_WEBHOOK_URL=
PNBA_PUBLIC_URL=
